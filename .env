# Endpoints da API do ConstruCode (descobertos via HAR) que o proxy consome
# no lugar da Fake Store API.

# Página de login: GET busca o __RequestVerificationToken, POST autentica
# e devolve o cookie de sessão.
CONSTRUCODE_LOGIN_URL=change-me

# Lista de empreendimentos (SPA Remix, formato "turbo-stream").
CONSTRUCODE_ENTERPRISES_URL=change-me

# Página do empreendimento (id via query string ?id=), contém as disciplinas
# em <select id="idDisciplina"> e o idUser usado no endpoint de itens.
CONSTRUCODE_PROJETO_URL=change-me

# Itens (documentos/plantas) de uma disciplina de um empreendimento.
CONSTRUCODE_PLANTAS_URL=change-me

# Credenciais da conta ConstruCode usada pelo proxy para logar.
# Preencha localmente — não commite os valores reais.
CONSTRUCODE_EMAIL=change-me
CONSTRUCODE_PASSWORD=change-me

# Porta local (Render define isso automaticamente em produção)
PORT=3000

# Token único que os clientes da nossa API devem mandar no header
# X-Api-Token em toda chamada. Sem relação com o cookie de sessão do
# ConstruCode (upstream) — é a autenticação do nosso proxy.
API_ACCESS_TOKEN=change-me
